# Normalise line endings in the repository, and decide what each file gets on checkout.
#
# This matters here rather than being boilerplate: `deploy/*.sh` and `deploy/holos.service`
# are executed by Linux. A Windows checkout with `core.autocrlf=true` would rewrite them
# with CRLF, and a shell script whose shebang ends `\r` fails with the unhelpful
# "bad interpreter: /usr/bin/env sh^M". Pinning them to LF makes that impossible.

# Let git decide for anything not named below.
* text=auto

# ---------------------------------------------------------------- must be LF
*.sh            text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
Caddyfile       text eol=lf
*.conf          text eol=lf
*.env           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# RDF fixtures: N-Triples and N-Quads are line-based and compared byte for byte by the
# conformance harness, so a line-ending rewrite would show up as a test failure.
*.nt            text eol=lf
*.nq            text eol=lf
*.ttl           text eol=lf
*.trig          text eol=lf
*.n3            text eol=lf
*.rq            text eol=lf
*.ru            text eol=lf
*.srx           text eol=lf
*.srj           text eol=lf

# Source and documentation.
*.rs            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.pyi           text eol=lf
*.html          text eol=lf

# ---------------------------------------------------------- Windows scripts
# PowerShell is happiest with CRLF, and these only ever run on Windows.
*.ps1           text eol=crlf

# ---------------------------------------------------------------- binary
*.png           binary
*.jpg           binary
*.gz            binary
*.zip           binary
*.whl           binary
*.pdf           binary

# ---------------------------------------------------------------- diffs
# The conformance baselines are generated; a diff of them is noise unless you are
# specifically reviewing a conformance change.
conformance/*.failures  linguist-generated=true

# Cargo.lock is committed (this workspace ships binaries) but is not worth reading in a
# pull request.
Cargo.lock      linguist-generated=true
